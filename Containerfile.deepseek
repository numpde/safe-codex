FROM node:24-bookworm-slim

ARG DSH_VERSION=0.1.1-rc.2

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    bash \
    ca-certificates \
    git \
    less \
    openssh-client \
    ripgrep \
  && rm -rf /var/lib/apt/lists/*

RUN npm install -g "@deepseek-ai/dsh@${DSH_VERSION}" --ignore-scripts --no-audit --no-fund \
  && command -v dsh >/dev/null \
  && test -f /usr/local/lib/node_modules/@deepseek-ai/dsh/lib/bin.js \
  && npm cache clean --force \
  && rm -f /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack \
  && rm -rf /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/corepack /root/.npm /tmp/*

RUN mkdir -p /workspace /home/codex/.dsh /home/codex/.cache /home/codex/.local/share \
  && chown -R node:node /workspace /home/codex

USER node
ENV HOME=/home/codex
ENV SHELL=/bin/bash
WORKDIR /workspace

# The current developer-preview release cannot boot its profiles when its
# native loader-internals fallback fails. Pass the narrow Node startup flag on
# this process only; NODE_OPTIONS would also affect agent-spawned Node commands.
ENTRYPOINT ["node", "--expose-internals", "/usr/local/lib/node_modules/@deepseek-ai/dsh/lib/bin.js"]
